# Required for Q&A, quiz, summary and learning-path features.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Current Gemini model can be changed without editing Python code.
GEMINI_MODEL=gemini-2.5-flash

# The project document specifies LaMini-Flan-T5 for explanations.
# Set false if you want the explanation module to use Gemini instead.
USE_LOCAL_EXPLANATION=true

LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
